<header class="lh-header">
  <div class="lh-header__inner">

    <a href="{{ routes.root_url }}" class="lh-header__logo">
      {{- section.settings.logo_text | default: shop.name -}}
    </a>

    {%- if section.settings.tagline != blank -%}
      <p class="lh-header__tagline">{{ section.settings.tagline }}</p>
    {%- endif -%}

    <div class="lh-header__actions">
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="lh-btn lh-btn--secondary lh-header__cta">
          {{ section.settings.button_label }}
          <svg class="lh-btn__arrow" width="18" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true">
            <path d="M1 6h15M11 1l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {%- endif -%}

      <button type="button" class="lh-header__cart" data-cart-open aria-label="Open cart">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 8h14l-1 12H6L5 8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
          <path d="M9 8V6a3 3 0 0 1 6 0v2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        <span class="lh-header__count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>
          {{- cart.item_count -}}
        </span>
      </button>
    </div>

  </div>
</header>

<script src="{{ 'lh-header.js' | asset_url }}" defer></script>

{% stylesheet %}
  .lh-header {
    background: var(--lh-cream);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }
  .lh-header__inner {
    max-width: var(--lh-page-width);
    margin: 0 auto;
    padding: 0 var(--lh-gutter);
    min-height: calc(var(--lh-header-h) - 1px); /* 1px = bottom border */
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
  }
  .lh-header__logo {
    font-family: var(--lh-font-head);
    font-size: 24px;
    font-weight: 700;
    color: var(--lh-text);
    text-decoration: none;
  }
  .lh-header__tagline { margin: 0; font-size: 14px; text-align: center; }
  .lh-header__actions { display: flex; justify-content: flex-end; align-items: center; gap: 24px; }
  /* .lh-header prefix = higher priority than the shared .lh-btn rules in lh-base.css */
  .lh-header .lh-header__cta { padding: 14px 24px; }

  .lh-header__cart {
    position: relative;
    padding: 0;
    border: 0;
    background: none;
    color: var(--lh-text);
    cursor: pointer;
  }
  .lh-header__count {
    position: absolute;
    top: -6px;
    right: -8px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 999px;
    background: var(--lh-olive);
    color: var(--lh-white);
    font-size: 10px;
    font-weight: 700;
    line-height: 16px;
    text-align: center;
  }
  .lh-header__count[hidden] { display: none; }

  /* Mobile Figma: only logo + cart */
  @media (max-width: 749px) {
    .lh-header__inner { grid-template-columns: 1fr auto; }
    .lh-header .lh-header__tagline,
    .lh-header .lh-header__cta { display: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "LH Header",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "Loomhaus" },
    { "type": "text", "id": "tagline", "label": "Header text", "default": "Clothes made to be worn for years, not seasons." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the drop" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ]
}
{% endschema %}
