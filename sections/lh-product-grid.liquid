<section class="lh-grid">
  <div class="lh-grid__inner">

    <div class="lh-grid__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="lh-grid__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="lh-grid__title">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.hint != blank -%}
        <p class="lh-grid__hint">{{ section.settings.hint }}</p>
      {%- endif -%}
    </div>

    <ul class="lh-grid__list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign product = block.settings.product
          assign tile_image = block.settings.image | default: product.featured_image
        -%}
        <li class="lh-tile" {{ block.shopify_attributes }}>
          {%- if tile_image != blank -%}
            {{
              tile_image
              | image_url: width: 700
              | image_tag:
                loading: 'lazy',
                widths: '300, 450, 600, 700',
                sizes: '(min-width: 750px) 30vw, 46vw',
                class: 'lh-tile__img',
                alt: product.title
            }}
          {%- else -%}
            {{ 'product-apparel-1' | placeholder_svg_tag: 'lh-tile__img lh-tile__placeholder' }}
          {%- endif -%}

          {%- if product != blank -%}
            <button
              type="button"
              class="lh-hotspot"
              data-quickview="{{ product.handle }}"
              style="left: {{ block.settings.x }}%; top: {{ block.settings.y }}%;"
              aria-label="Quick view {{ product.title | escape }}"
            >
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              </svg>
            </button>

            <p class="lh-tile__label">
              <span class="lh-tile__name">{{ product.title }}</span>
              <span class="lh-tile__price">{{ product.price | money }}</span>
            </p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

  </div>
</section>

{% stylesheet %}
  .lh-grid { background: var(--lh-cream); }
  .lh-grid__inner {
    max-width: var(--lh-page-width);
    margin: 0 auto;
    padding: 64px var(--lh-gutter) 80px;
  }

  .lh-grid__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: 28px;
  }
  .lh-grid__eyebrow {
    margin: 0 0 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--lh-olive);
  }
  .lh-grid__title {
    margin: 0;
    font-family: var(--lh-font-head);
    font-size: clamp(30px, 3.2vw, 44px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .lh-grid__hint { margin: 0; font-size: 13px; color: var(--lh-muted); }

  .lh-grid__list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lh-tile {
    position: relative;
    aspect-ratio: 5 / 6;
    overflow: hidden;
    border-radius: 18px;
    background: var(--lh-sand);
  }
  .lh-tile__img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* ---------- Hotspot (+) ---------- */
  .lh-hotspot {
    position: absolute;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--lh-white);
    color: var(--lh-text);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
    cursor: pointer;
    transform: translate(-50%, -50%);
    transition: transform 0.2s ease;
  }
  @media (hover: hover) {
    .lh-hotspot:hover { transform: translate(-50%, -50%) scale(1.25); }
  }

  /* ---------- Label ---------- */
  .lh-tile__label {
    position: absolute;
    left: 12px;
    bottom: 12px;
    display: flex;
    gap: 8px;
    margin: 0;
    padding: 7px 14px;
    border-radius: 999px;
    background: var(--lh-white);
    font-size: 12px;
    line-height: 1.2;
  }
  .lh-tile__price { font-weight: 700; }

  /* ---------- Mobile: 2 columns, label stacks ---------- */
  @media (max-width: 749px) {
    .lh-grid__inner { padding-top: 40px; padding-bottom: 48px; }
    .lh-grid__hint { display: none; }
    .lh-grid__list { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .lh-tile { border-radius: 14px; }
    .lh-tile__label {
      flex-direction: column;
      gap: 2px;
      left: 8px;
      bottom: 8px;
      padding: 8px 12px;
      border-radius: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "LH Product grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Shop the look" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loomhaus in the wild" },
    { "type": "text", "id": "hint", "label": "Hint text", "default": "Tap the + on any look to shop it." }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Image (optional)", "info": "Leave empty to use the product's first image." },
        { "type": "header", "content": "Hotspot (+) position" },
        { "type": "range", "id": "x", "label": "Horizontal (%)", "min": 0, "max": 100, "step": 1, "default": 50 },
        { "type": "range", "id": "y", "label": "Vertical (%)", "min": 0, "max": 100, "step": 1, "default": 40 }
      ]
    }
  ],
  "presets": [
    {
      "name": "LH Product grid",
      "blocks": [
        { "type": "tile" }, { "type": "tile" }, { "type": "tile" },
        { "type": "tile" }, { "type": "tile" }, { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
