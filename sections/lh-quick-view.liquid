{%- comment -%}
  Quick view popup.
  On a normal page `product` is empty, so only the empty shell is printed.
  JS fetches "<product url>?section_id=lh-quick-view": Shopify then renders this
  same section with that product, and JS copies the [data-qv-content] part into the shell.
{%- endcomment -%}

<div class="lh-qv" data-qv aria-hidden="true">
  <div class="lh-qv__overlay" data-qv-close></div>

  <div class="lh-qv__dialog" role="dialog" aria-modal="true" aria-labelledby="lh-qv-title">
    <span class="lh-qv__handle" aria-hidden="true"></span>

    <div class="lh-qv__content" data-qv-content>
      {%- if product != blank -%}
        {%- liquid
          assign color_pos = 0
          assign size_pos = 0
          for option in product.options_with_values
            assign option_name = option.name | downcase
            if option_name == 'color' or option_name == 'colour'
              assign color_pos = option.position
            elsif option_name == 'size'
              assign size_pos = option.position
            endif
          endfor

          assign color_idx = color_pos | minus: 1
          assign size_idx = size_pos | minus: 1
          assign current = product.selected_or_first_available_variant
          assign current_color = ''
          if color_pos > 0
            assign current_color = current.options[color_idx]
          endif
        -%}

        {%- comment -%} Variant data for JS: just what it needs to pick a variant and show a price. {%- endcomment -%}
        <script type="application/json" data-qv-variants>
          [
            {%- for v in product.variants -%}
              {%- liquid
                assign v_color = ''
                assign v_size = ''
                if color_pos > 0
                  assign v_color = v.options[color_idx]
                endif
                if size_pos > 0
                  assign v_size = v.options[size_idx]
                endif
              -%}
              { "id": {{ v.id }}, "color": {{ v_color | json }}, "size": {{ v_size | json }}, "available": {{ v.available }}, "price": {{ v.price | money | json }} }
              {%- unless forloop.last %},{% endunless -%}
            {%- endfor -%}
          ]
        </script>

        {%- liquid
          assign start_image = product.featured_image
          if color_pos > 0
            for v in product.variants
              if v.options[color_idx] == current_color and v.featured_image
                assign start_image = v.featured_image
                break
              endif
            endfor
          endif
        -%}

        <div class="lh-qv__media">
          {%- if start_image -%}
            {{ start_image | image_url: width: 600 | image_tag: loading: 'eager', alt: product.title, class: 'lh-qv__img' }}
          {%- endif -%}
        </div>

        <div class="lh-qv__info">
          <div class="lh-qv__top">
            <div>
              <h2 class="lh-qv__title" id="lh-qv-title">{{ product.title }}</h2>
              <p class="lh-qv__price" data-qv-price>{{ current.price | money }}</p>
            </div>
            <button type="button" class="lh-qv__close" data-qv-close aria-label="Close quick view">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              </svg>
            </button>
          </div>

          {%- if product.description != blank -%}
            <p class="lh-qv__desc">{{ product.description | strip_html | truncatewords: 26 }}</p>
          {%- endif -%}

          {%- if color_pos > 0 -%}
            <p class="lh-qv__label">Color</p>
            <div class="lh-qv__colors" role="group" aria-label="Color">
              {%- for color_value in product.options_with_values[color_idx].values -%}
                {%- liquid
                  assign swatch_handle = color_value | handleize
                  assign swatch = shop.metaobjects.color_swatch[swatch_handle]
                  assign dot = swatch.hex.value | default: color_value
                  assign color_image = product.featured_image
                  for v in product.variants
                    if v.options[color_idx] == color_value and v.featured_image
                      assign color_image = v.featured_image
                      break
                    endif
                  endfor
                -%}
                <button
                  type="button"
                  class="lh-qv__color"
                  data-value="{{ color_value | escape }}"
                  data-image="{{ color_image | image_url: width: 600 }}"
                  aria-pressed="{% if color_value == current_color %}true{% else %}false{% endif %}"
                >
                  <span class="lh-qv__dot" style="background: {{ dot }};"></span>
                  {{ color_value }}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if size_pos > 0 -%}
            <p class="lh-qv__label">Size</p>
            <div class="lh-qv__select">
              <select data-qv-size aria-label="Size">
                <option value="">Choose your size</option>
                {%- for size_value in product.options_with_values[size_idx].values -%}
                  <option value="{{ size_value | escape }}" data-label="{{ size_value | escape }}">{{ size_value }}</option>
                {%- endfor -%}
              </select>
              <svg width="12" height="8" viewBox="0 0 12 8" fill="none" aria-hidden="true">
                <path d="M1 1.5l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          {%- endif -%}

          <p class="lh-qv__error" data-qv-error role="alert" hidden></p>

          <button type="button" class="lh-btn lh-btn--primary lh-qv__add" data-qv-add>
            Add to cart
            <svg class="lh-btn__arrow" width="18" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true">
              <path d="M1 6h15M11 1l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script src="{{ 'lh-quick-view.js' | asset_url }}" defer></script>

{% stylesheet %}
  .lh-qv {
    position: fixed;
    inset: 0;
    z-index: 900;
    visibility: hidden;
    font-family: var(--lh-font-body);
    transition: visibility 0s linear 0.25s;
  }
  .lh-qv.is-open { visibility: visible; transition-delay: 0s; }

  .lh-qv__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .lh-qv.is-open .lh-qv__overlay { opacity: 1; }

  /* Desktop: centred card */
  .lh-qv__dialog {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(584px, 92vw);
    padding: 20px;
    border-radius: 18px;
    background: var(--lh-white);
    color: var(--lh-text);
    opacity: 0;
    transform: translate(-50%, -48%);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .lh-qv.is-open .lh-qv__dialog { opacity: 1; transform: translate(-50%, -50%); }
  .lh-qv.is-loading .lh-qv__content { opacity: 0.4; min-height: 200px; }

  .lh-qv__handle { display: none; }
  .lh-qv__content { display: grid; grid-template-columns: 200px 1fr; gap: 20px; transition: opacity 0.2s ease; }

  .lh-qv__media { border-radius: 12px; overflow: hidden; background: var(--lh-sand); aspect-ratio: 3 / 4; }
  .lh-qv__img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .lh-qv__top { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
  .lh-qv__title { margin: 0; font-family: var(--lh-font-head); font-size: 20px; font-weight: 700; line-height: 1.2; }
  .lh-qv__price { margin: 4px 0 0; font-size: 14px; }
  .lh-qv__close { padding: 2px; border: 0; background: none; color: inherit; cursor: pointer; }
  .lh-qv__desc { margin: 12px 0 14px; font-size: 12px; line-height: 1.5; color: var(--lh-muted); }

  .lh-qv__label {
    margin: 12px 0 6px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .lh-qv__colors { display: grid; grid-template-columns: repeat(auto-fit, minmax(96px, 1fr)); gap: 8px; }
  .lh-qv__color {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 8px;
    background: var(--lh-white);
    font: inherit;
    font-size: 13px;
    color: inherit;
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .lh-qv__color[aria-pressed='true'] { border-color: var(--lh-text); background: var(--lh-cream); }
  @media (hover: hover) { .lh-qv__color:hover { border-color: var(--lh-text); } }
  .lh-qv__dot { width: 10px; height: 10px; border-radius: 50%; border: 1px solid rgba(0, 0, 0, 0.25); }

  .lh-qv__select { position: relative; }
  .lh-qv__select select {
    width: 100%;
    padding: 10px 34px 10px 12px;
    border: 1px solid var(--lh-text);
    border-radius: 8px;
    background: var(--lh-white);
    font: inherit;
    font-size: 13px;
    color: inherit;
    appearance: none;
    cursor: pointer;
  }
  .lh-qv__select svg { position: absolute; top: 50%; right: 12px; transform: translateY(-50%); pointer-events: none; }

  .lh-qv__error { margin: 8px 0 0; font-size: 12px; color: var(--lh-red); }
  .lh-qv .lh-qv__add { display: flex; justify-content: center; width: 100%; margin-top: 14px; }

  /* Mobile: bottom sheet */
  @media (max-width: 749px) {
    .lh-qv__dialog {
      top: auto;
      bottom: 0;
      left: 0;
      width: 100%;
      max-height: 92vh;
      overflow-y: auto;
      padding: 14px 16px 24px;
      border-radius: 24px 24px 0 0;
      opacity: 1;
      transform: translateY(100%);
    }
    .lh-qv.is-open .lh-qv__dialog { transform: none; }

    .lh-qv__handle { display: block; width: 44px; height: 4px; margin: 0 auto 14px; border-radius: 4px; background: var(--lh-sand-hover); }
    .lh-qv__content { grid-template-columns: 1fr; gap: 14px; }
    .lh-qv__media { aspect-ratio: 4 / 3; }
    .lh-qv__img { object-position: top; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "LH Quick view",
  "settings": [
    { "type": "paragraph", "content": "Popup opened by the + hotspots. Product details come from the clicked product." }
  ]
}
{% endschema %}
